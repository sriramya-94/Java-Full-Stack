<!DOCTYPE html>
<html>
<head>
    <title>CSS Selectors</title>

    <style>
        p {
            color: blue;
        }

        .name {
            color: green;
        }

        #title {
            color: red;
        }
    </style>
</head>
<body>

<h1 id="title">CSS Selectors</h1>

<p>Element Selector</p>
<p class="name">Class Selector</p>

</body>
</html>
