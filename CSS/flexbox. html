<!DOCTYPE html>
<html>
<head>
    <title>CSS Flexbox</title>

    <style>
        .container {
            display: flex;
            gap: 20px;
        }

        .box {
            padding: 30px;
            background-color: lightblue;
        }
    </style>
</head>
<body>

<h1>Flexbox</h1>

<div class="container">
    <div class="box">Box 1</div>
    <div class="box">Box 2</div>
    <div class="box">Box 3</div>
</div>

</body>
</html>
