<!DOCTYPE html>
<html>
<head>
    <title>Hover Animation</title>

    <style>
        button {
            padding: 15px 30px;
            transition: 0.5s;
        }

        button:hover {
            transform: scale(1.2);
        }
    </style>
</head>
<body>

<h1>Hover Animation</h1>

<button>Hover Me</button>

</body>
</html>
